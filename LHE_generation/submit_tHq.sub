universe = vanilla
executable = run_gridpack_tHq.sh
arguments = $(Cluster) $(Process)
transfer_executable = True
log    = logs/tHq_job_$(Process).log
output = outs/tHq_job_$(Process).out
error  = errs/tHq_job_$(Process).err
request_cpus = 4
request_memory = 4 GB
request_disk = 2 GB
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = ./tHq_gridpack_dir/run_01_gridpack.tar.gz
transfer_output_files = tHq_events_$(Cluster)_$(Process).lhe.gz
transfer_output_remaps = "tHq_events_$(Cluster)_$(Process).lhe.gz=./output/tHq/tHq_events_$(Cluster)_$(Process).lhe.gz"
queue 8
