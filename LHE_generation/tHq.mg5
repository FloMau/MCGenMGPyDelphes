import model sm
set gauge unitary
define l+ = e+ mu+ ta+
define l- = l- mu- ta-
# semi-leptonic top decay only
generate p p > t h j b~ $$ w+ w-, (t > W+ b, W+ > l+ vl)
add process p p > t~ h j b $$ w+ w-, (t~ > W- b~, W- > l- vl~)

output tHq_gridpack_dir

launch tHq_gridpack_dir

# Shower and Delphes after the generation with gridpacks
# Unfortunately, Madspin and gridpack does not work properly, so we use decay chain syntax
# Runs a little longer but probably easier compared to trying to set up Madspin on top of lhe events...
analysis=OFF
done

set use_syst False
set ebeam 7000
set gridpack True
set nevents 50k
done
